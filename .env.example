# ============================================================
# Application
# ============================================================
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api
# Lista separada por comas de orígenes permitidos para CORS
CORS_ORIGINS=http://localhost:5173

# ============================================================
# Base de datos propia del producto
# (No es la base de Innlab Core. Cada producto tiene la suya.
#  Nunca hagas JOIN entre esta base y la de Core.)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=change_me
DB_USER=change_me
DB_PASSWORD=change_me
DB_SSL=false

# ============================================================
# Cognito — validación de tokens de usuario
# Mismo User Pool que usa Innlab Core: pídelo al equipo de Core,
# no crees un User Pool nuevo para tu producto.
# ============================================================
COGNITO_JWKS_URI=https://cognito-idp.<region>.amazonaws.com/<userPoolId>/.well-known/jwks.json
COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<userPoolId>

# ============================================================
# Innlab Core API — comunicación saliente (contexto de usuario/empresa)
# ============================================================
INNLAB_API_BASE_URL=http://localhost:3001
INNLAB_API_TIMEOUT=5000

# ============================================================
# Core API — comunicación interna entrante
# Key que el equipo de Core te asigna en internal.guard.ts
# (SERVICE_KEY_ENV -> INTERNAL_KEY_<TU_PRODUCTO>)
# ============================================================
CORE_INTERNAL_KEY=pide_esta_key_al_equipo_de_core
